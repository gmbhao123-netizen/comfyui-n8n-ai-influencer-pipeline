son = JSON.parse(rawText);\n  }\n} catch (e) {\n  cleanJson = {\n    instagram_caption: 'Cute sunny moments ✨ What are you up to today? 🌸 #cute #aesthetic #lifestyle',\n    x_tweet: 'Little candid moment from today ✨ Hope you have a wonderful afternoon! 💖 #aesthetic'\n  };\n}\n\nreturn [{\n  json: {\n    ...cleanJson,\n    final_media_url: $('Drive: Save Swapped Asset').item.json.webContentLink,\n    final_media_type: $('Route by Media Type').item.json.mediaType\n  }\n}];"},"id":"node-parse-captions","name":"Parse Clean Captions","type":"n8n-nodes-base.code","typeVersion":2,"position":[3100,200]},{"parameters":{"amount":"={{ Math.floor(Math.random() * (45 - 20 + 1) + 20) }}","unit":"minutes"},"id":"node-human-delay","name":"Random Anti-Bot Delay (20-45m)","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[3320,200]},{"parameters":{"text":"={{ $json.x_tweet }}","additionalFields":{"attachments":{"media":{"media":{"values":[{"binaryPropertyName":"data"}]}}}}},"id":"node-post-x-twitter","name":"Post to X (Twitter)","type":"n8n-nodes-base.twitter","typeVersion":2,"position":[3560,120]},{"parameters":{"operation":"upload","mediaType":"IMAGE","imageUrl":"={{ $json.final_media_url }}","caption":"={{ $json.instagram_caption }}","additionalFields":{}},"id":"node-post-instagram","name":"Post to Instagram Creator","type":"n8n-nodes-base.instagram","typeVersion":1,"position":[3560,320]}],"connections":{"Telegram Media Trigger":{"main":[[{"node":"Is Photo or Video?","type":"main","index":0}]]},"Is Photo or Video?":{"main":[[{"node":"Parse Media & Extract FileID","type":"main","index":0}]]},"Parse Media & Extract FileID":{"main":[[{"node":"Download File from Telegram","type":"main","index":0}]]},"Download File from Telegram":{"main":[[{"node":"Route by Media Type","type":"main","index":0}]]},"Route by Media Type":{"main":[[{"node":"Drive: Upload Raw Image","type":"main","index":0}],[{"node":"Drive: Upload Raw Video","type":"main","index":0}]]},"Drive: Upload Raw Image":{"