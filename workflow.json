{"name":"AI Influencer Pipeline - Telegram to RunPod FaceSwap & Multi-Platform AutoPost","nodes":[{"parameters":{"updates":["message","channel_post"],"additionalFields":{}},"id":"node-telegram-trigger","name":"Telegram Media Trigger","type":"n8n-nodes-base.telegramTrigger","typeVersion":1.1,"position":[200,300],"webhookId":"tele-ingest-sub"},{"parameters":{"conditions":{"boolean":[{"value1":"={{ Boolean($json.message?.photo || $json.message?.video || $json.channel_post?.photo || $json.channel_post?.video) }}","value2":true}]}},"id":"node-filter-media","name":"Is Photo or Video?","type":"n8n-nodes-base.if","typeVersion":2,"position":[420,300]},{"parameters":{"jsCode":"// Determine media type and extract file_id\nconst msg = $input.first().json.message || $input.first().json.channel_post;\nlet fileId = '';\nlet mediaType = '';\nlet originalCaption = msg.caption || '';\n\nif (msg.photo && msg.photo.length > 0) {\n  // Lấy ảnh độ phân giải cao nhất (phần tử cuối mảng)\n  fileId = msg.photo[msg.photo.length - 1].file_id;\n  mediaType = 'IMAGE';\n} else if (msg.video) {\n  fileId = msg.video.file_id;\n  mediaType = 'VIDEO';\n}\n\nreturn [{\n  json: {\n    fileId,\n    mediaType,\n    caption: originalCaption,\n    timestamp: new Date().toISOString()\n  }\n}];"},"id":"node-parse-media-meta","name":"Parse Media & Extract FileID","type":"n8n-nodes-base.code","typeVersion":2,"position":[640,240]},{"parameters":{"resource":"file","operation":"get","fileId":"={{ $json.fileId }}","additionalFields":{}},"id":"node-telegram-download","name":"Download File from Telegram","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[860,240]},{"parameters":{"conditions":{"string":[{"value1":"={{ $json.mediaType }}","value2":"IMAGE"}]}},"id":"node-check-media-type","name":"Route by Media Type","type":"n8n-nodes-base.if","typeVersion":2,"position":[1080,240]},{"parameters":{"authentication":"serviceAccount","operation":"upload","name":"=raw_img_{{ $now.toFormat('yyyyLLdd_HHmmss') }}.